# ─────────────────────────────────────────────────────────────
# Base de dados
# O provider do Prisma é derivado automaticamente do prefixo do URL
# (mysql:// → mysql | postgresql:// → postgresql) por scripts/prisma-provider.mjs
#
# LOCAL (XAMPP MySQL) — ajuste a porta (3306 por omissão; 3307 em alguns XAMPP):
DATABASE_URL="mysql://root:@127.0.0.1:3307/gestao_membresia"
#
# PRODUÇÃO (Vercel + Neon PostgreSQL) — definir na Vercel:
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/gestao?sslmode=require"
# ─────────────────────────────────────────────────────────────

# Auth.js (NextAuth v5)
# Gerar com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET="troca-isto-por-um-segredo-aleatorio-de-32-bytes"

# URL base da aplicação
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
